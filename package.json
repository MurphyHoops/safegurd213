{
  "name": "safegurd213-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "NODE_OPTIONS='--expose-gc' tsx server.ts",
    "daemon": "tsx src/daemon/daemon_engine.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node --expose-gc --max-old-space-size=4096 dist/server.cjs",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' tsx server.ts\" \"wait-on http://localhost:3000 && electron .\"",
    "dist:win": "npm run build && npx --yes electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "description": "0211自动找币防爆仓救世之星",
  "author": "TradingMaster",
  "build": {
    "electronVersion": "33.2.0",
    "appId": "com.cryptotrading.savior",
    "productName": "0211自动找币防爆仓救世之星",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "0211自动找币防爆仓救世之星",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "https-proxy-agent": "^9.1.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.555.0",
    "motion": "^12.38.0",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.8.1",
    "ws": "^8.19.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.2.0"
  }
}
