                subValB = getLivePnLPercent(b);
            } else if (curSortType === 'AMOUNT') {
                const priceA = resolvePrice(a.symbol, curPrices, a.markPrice || a.entryPrice);
                const priceB = resolvePrice(b.symbol, curPrices, b.markPrice || b.entryPrice);
